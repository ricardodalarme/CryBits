<Window
    x:Class="CryBits.Editors.Forms.Login.LoginWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CryBits.Editors.Forms.Login"
    Title="Login"
    Width="540"
    Height="400"
    x:DataType="vm:LoginViewModel"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen">

    <StackPanel Margin="14" Spacing="10">

        <!--  Logo  -->
        <Image
            Height="141"
            Source="avares://CryBits.Editors/AvaloniaUI/Assets/Logo.webp"
            Stretch="Uniform" />

        <!--  Two-column: instructions (left) + login fields (right)  -->
        <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="16">

            <!--  Getting-started instructions  -->
            <Border
                Grid.Column="0"
                Padding="10"
                VerticalAlignment="Stretch">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="Bold" Text="Getting started?" />
                    <TextBlock Text="1. Start the CryBits Server" TextWrapping="Wrap" />
                    <TextBlock Text="2. Open the CryBits Client and create an account" TextWrapping="Wrap" />
                    <TextBlock Text="3. Login to that account to start creating your game!" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Login fields  -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="6">
                <TextBlock Text="Username:" />
                <TextBox Text="{Binding Username}" />

                <TextBlock Margin="0,4,0,0" Text="Password:" />
                <TextBox PasswordChar="*" Text="{Binding Password}" />

                <CheckBox
                    Margin="0,4,0,0"
                    Content="Save username"
                    IsChecked="{Binding SaveUsername}" />
                <Button
                    Margin="0,4,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ConnectCommand}"
                    Content="Connect"
                    IsDefault="True" />
            </StackPanel>

        </Grid>
    </StackPanel>

</Window>