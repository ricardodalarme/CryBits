<UserControl
    x:Class="CryBits.Editors.Forms.Maps.Panes.LayersPane"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CryBits.Editors.Forms.Maps.Models"
    xmlns:panes="using:CryBits.Editors.Forms.Maps.Panes"
    x:DataType="models:LayerVm">
    <TabControl x:Name="mainTabs">
        <TabItem Header="Layers">
            <ScrollViewer>
                <StackPanel Margin="4" Spacing="4">

                    <!--  Layers group  -->
                    <Border x:Name="grpLayersBorder" Padding="4">
                        <Grid RowDefinitions="Auto,Auto">
                            <DataGrid
                                x:Name="lstLayers"
                                Grid.Row="0"
                                Height="128"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="False"
                                CanUserSortColumns="False"
                                GridLinesVisibility="Horizontal"
                                IsReadOnly="False"
                                SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn
                                        Width="22"
                                        Binding="{Binding Visible}"
                                        Header="" />
                                    <DataGridTextColumn
                                        Width="24"
                                        Binding="{Binding Index}"
                                        Header="Nº"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Name}"
                                        Header="Name"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        Width="50"
                                        Binding="{Binding TypeName}"
                                        Header="Type"
                                        IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,3,0,0"
                                Orientation="Horizontal"
                                Spacing="3">
                                <Button x:Name="butLayers_Add" Content="Add" />
                                <Button x:Name="butLayers_Remove" Content="Remove" />
                                <Button x:Name="butLayers_Edit" Content="Edit" />
                                <Separator Width="4" />
                                <Button x:Name="butLayers_Up" Content="↑" />
                                <Button x:Name="butLayers_Down" Content="↓" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Layer add/edit panel (hidden by default)  -->
                    <Border
                        x:Name="pnlLayerEdit"
                        Padding="8"
                        IsVisible="False">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="lblLayerEditTitle"
                                FontWeight="Bold"
                                Text="Add layer" />
                            <TextBlock Text="Name:" />
                            <TextBox x:Name="txtLayer_Name" MaxLength="12" />
                            <TextBlock Margin="0,4,0,0" Text="Type:" />
                            <ComboBox x:Name="cmbLayers_Type" HorizontalAlignment="Stretch" />
                            <Grid
                                Margin="0,4,0,0"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="4">
                                <Button
                                    x:Name="butLayer_Ok"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Content="Add" />
                                <Button
                                    x:Name="butLayer_Cancel"
                                    Grid.Column="1"
                                    Content="Cancel" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Chunks">
            <panes:ChunksPane x:Name="chunksPane" />
        </TabItem>
    </TabControl>
</UserControl>