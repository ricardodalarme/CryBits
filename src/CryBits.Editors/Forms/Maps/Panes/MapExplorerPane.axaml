<UserControl
    x:Class="CryBits.Editors.Forms.Maps.Panes.MapExplorerPane"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBox
            x:Name="txtFilter"
            Grid.Row="0"
            Margin="4,4,4,2"
            PlaceholderText="Filter maps…" />
        <StackPanel
            Grid.Row="1"
            Margin="4,0,4,2"
            Orientation="Horizontal"
            Spacing="4">
            <Button x:Name="butNew" Content="New" />
            <Button x:Name="butRemove" Content="Remove" />
        </StackPanel>
        <ListBox
            x:Name="lstMaps"
            Grid.Row="2"
            Margin="4,0,4,4"
            SelectionMode="Single" />
    </Grid>
</UserControl>