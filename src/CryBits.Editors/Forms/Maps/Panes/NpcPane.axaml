<UserControl
    x:Class="CryBits.Editors.Forms.Maps.Panes.NpcPane"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="4" Spacing="6">
        <TextBlock FontWeight="Bold" Text="NPCs" />
        <TextBlock Text="NPC:" />
        <ComboBox x:Name="cmbNPC" HorizontalAlignment="Stretch" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Zone:" />
            <NumericUpDown
                x:Name="numNPC_Zone"
                Grid.Column="1"
                Maximum="20"
                Minimum="0" />
        </Grid>
        <Button
            x:Name="butNPC_Add"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Content="Add" />
        <ListBox x:Name="lstNPC" Height="180" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
            <Button
                x:Name="butNPC_Remove"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Content="Remove" />
            <Button
                x:Name="butNPC_Clear"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Content="Clear" />
        </Grid>
    </StackPanel>
</UserControl>