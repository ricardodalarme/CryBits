<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CryBits.Editors.Forms.Maps.Panes.ZonesPane">
    <StackPanel Spacing="6" Margin="4">
        <TextBlock x:Name="lblZone" Text="Zone: None" FontWeight="Bold" />
        <ScrollBar x:Name="scrlZone"
                   Orientation="Horizontal"
                   Minimum="0" Maximum="20" Value="0" />
        <Button Content="Clear" x:Name="butZonesClear"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
    </StackPanel>
</UserControl>