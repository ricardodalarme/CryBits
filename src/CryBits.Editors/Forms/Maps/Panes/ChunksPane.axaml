<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CryBits.Editors.Forms.Maps.Panes.ChunksPane">
    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiBorderColor}"
            CornerRadius="4" Padding="4">
        <Grid RowDefinitions="*,Auto">
            <ListBox x:Name="lstChunks" Grid.Row="0" />

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="3" Margin="0,4,0,0">
                <Button Grid.Column="0" Content="←" x:Name="butChunkLeft"
                        ToolTip.Tip="Add chunk to left" />
                <Button Grid.Column="1" Content="↑" x:Name="butChunkUp"
                        ToolTip.Tip="Add chunk above" />
                <Button Grid.Column="2" Content="↓" x:Name="butChunkDown"
                        ToolTip.Tip="Add chunk below" />
                <Button Grid.Column="3" Content="→" x:Name="butChunkRight"
                        ToolTip.Tip="Add chunk to right" />
                <Button Grid.Column="4" Content="−" x:Name="butDeleteChunk"
                        ToolTip.Tip="Delete current chunk" />
            </Grid>
        </Grid>
    </Border>
</UserControl>