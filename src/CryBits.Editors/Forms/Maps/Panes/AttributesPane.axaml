<UserControl
    x:Class="CryBits.Editors.Forms.Maps.Panes.AttributesPane"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="4" Spacing="6">
        <TextBlock FontWeight="Bold" Text="Attribute" />
        <RadioButton
            x:Name="optA_Block"
            Content="Block"
            GroupName="Attr"
            IsChecked="True" />
        <RadioButton
            x:Name="optA_Warp"
            Content="Warp"
            GroupName="Attr" />
        <RadioButton
            x:Name="optA_Item"
            Content="Item Spawn"
            GroupName="Attr" />
        <RadioButton
            x:Name="optA_DirBlock"
            Content="Directional Block"
            GroupName="Attr" />

        <Border
            x:Name="grpA_Warp"
            Padding="6"
            IsVisible="False">
            <StackPanel Spacing="4">
                <TextBlock Text="Warp to map:" />
                <ComboBox x:Name="cmbA_Warp_Map" HorizontalAlignment="Stretch" />
                <TextBlock Text="Direction:" />
                <ComboBox x:Name="cmbA_Warp_Direction" HorizontalAlignment="Stretch" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="X:" />
                        <NumericUpDown
                            x:Name="numA_Warp_X"
                            Maximum="99"
                            Minimum="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Y:" />
                        <NumericUpDown
                            x:Name="numA_Warp_Y"
                            Maximum="99"
                            Minimum="0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border
            x:Name="grpA_Item"
            Padding="6"
            IsVisible="False">
            <StackPanel Spacing="4">
                <TextBlock Text="Item:" />
                <ComboBox x:Name="cmbA_Item" HorizontalAlignment="Stretch" />
                <TextBlock Text="Amount:" />
                <NumericUpDown
                    x:Name="numA_Item_Amount"
                    Maximum="32767"
                    Minimum="1" />
            </StackPanel>
        </Border>

        <Button
            x:Name="butAttributes_Clear"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Content="Clear All Attributes" />
        <Button
            x:Name="butAttributes_Import"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Content="Import from Tiles" />
    </StackPanel>
</UserControl>