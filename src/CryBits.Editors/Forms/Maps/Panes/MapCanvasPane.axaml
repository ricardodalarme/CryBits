<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:paz="using:Avalonia.Controls.PanAndZoom"
             x:Class="CryBits.Editors.Forms.Maps.Panes.MapCanvasPane">
    <Grid>
        <paz:ZoomBorder x:Name="zoomBorder"
                        Stretch="None"
                        EnablePan="True"
                        EnableZoom="True"
                        ZoomSpeed="1.2"
                        Background="Black"
                        ClipToBounds="True"
                        Focusable="True">
            <Image x:Name="imgMap" Stretch="None"
                   HorizontalAlignment="Left" VerticalAlignment="Top" />
        </paz:ZoomBorder>
    </Grid>
</UserControl>
