<Window
    x:Class="CryBits.Editors.Forms.Maps.EditorMapsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dock="using:Dock.Avalonia.Controls"
    xmlns:dockFactory="using:Dock.Model.Avalonia"
    xmlns:dockModel="using:Dock.Model.Avalonia.Controls"
    xmlns:panes="using:CryBits.Editors.Forms.Maps.Panes"
    Title="CryBits Editor"
    Width="1449"
    Height="735"
    MinWidth="931"
    MinHeight="686"
    CanResize="True"
    WindowStartupLocation="CenterScreen">

    <!--  ═══════════════════════════════════════════════════════════════════  -->
    <!--  Root grid: toolbar | content | statusbar  -->
    <!--  ═══════════════════════════════════════════════════════════════════  -->
    <Grid RowDefinitions="Auto,*,Auto">

        <panes:ToolbarPane x:Name="toolbarPane" Grid.Row="0" />

        <!--  ──────────────────────────────────────────────────────────────  -->
        <!--  Row 1 – Dock layout (inline UserControl content)  -->
        <!--  ──────────────────────────────────────────────────────────────  -->
        <dock:DockControl
            x:Name="DockControl"
            Grid.Row="1"
            InitializeFactory="True"
            InitializeLayout="True">
            <dock:DockControl.Factory>
                <dockFactory:Factory />
            </dock:DockControl.Factory>
            <dockModel:RootDock Id="Root" IsCollapsable="False">
                <dockModel:ProportionalDock Id="MainLayout" Orientation="Horizontal">

                    <!--  Left panel: Tile Sheet (top) + Layers & Modes (bottom)  -->
                    <dockModel:ToolDock Id="LeftDock" Proportion="0.21">
                        <dockModel:Tool
                            Title="Editor"
                            CanClose="False"
                            Id="LeftPanel" />
                    </dockModel:ToolDock>
                    <dockModel:ProportionalDockSplitter Id="LeftRightSplitter" />

                    <!--  Center: Map Canvas  -->
                    <dockModel:DocumentDock Id="MapDock">
                        <dockModel:Document
                            Title="Map Canvas"
                            CanClose="False"
                            Id="MapCanvas" />
                    </dockModel:DocumentDock>
                    <dockModel:ProportionalDockSplitter Id="CenterRightSplitter" />

                    <!--  Right panel: Map Explorer (top) + Properties (bottom)  -->
                    <dockModel:ProportionalDock
                        Id="RightPanel"
                        Orientation="Vertical"
                        Proportion="0.21">
                        <dockModel:ToolDock Id="ExplorerDock">
                            <dockModel:Tool
                                Title="Map Explorer"
                                CanClose="False"
                                Id="MapExplorer" />
                        </dockModel:ToolDock>
                        <dockModel:ProportionalDockSplitter Id="RightSplitter" />
                        <dockModel:ToolDock Id="PropertiesDock">
                            <dockModel:Tool
                                Title="Properties"
                                CanClose="False"
                                Id="Properties" />
                        </dockModel:ToolDock>
                    </dockModel:ProportionalDock>

                </dockModel:ProportionalDock>
            </dockModel:RootDock>
        </dock:DockControl>

        <!--  ──────────────────────────────────────────────────────────────  -->
        <!--  Row 2 – Status bar (FPS | Revision | Position)  -->
        <!--  ──────────────────────────────────────────────────────────────  -->
        <Border Grid.Row="2" Padding="6,3">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="lblFPS" Text="FPS: —" />
                <Separator Width="1" />
                <TextBlock x:Name="lblPosition" Text="Position: {0;0}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>