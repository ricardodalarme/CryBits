<Window
    x:Class="CryBits.Editors.Forms.UI.EditorUIThemeWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CryBits.Editors.Forms.UI"
    Title="UI Theme Editor"
    Width="1200"
    Height="700"
    x:DataType="vm:EditorUIThemeViewModel"
    WindowStartupLocation="CenterScreen">

    <Grid
        Margin="8"
        ColumnDefinitions="200,8,*"
        RowDefinitions="Auto,*,Auto">

        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Padding="8">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="Bold"
                    Text="Theme Files" />
                <ListBox
                    Grid.Row="2"
                    ItemsSource="{Binding FileList}"
                    SelectedItem="{Binding SelectedFileName}" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="2"
            RowDefinitions="*,8,Auto,8,200">

            <Border Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="Bold"
                        Text="{Binding FileName}" />
                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        FontFamily="Consolas, Courier New, monospace"
                        FontSize="12"
                        Text="{Binding FileContent}"
                        TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Padding="8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="Bold"
                        Text="Preview" />
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Background="Black">
                        <Image
                            x:Name="imgPreview"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Stretch="None" />
                    </Border>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Spacing="4">
                        <Button Command="{Binding RefreshPreviewCommand}" Content="Refresh Preview" />
                        <Button Command="{Binding RevertFileCommand}" Content="Revert File" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Button
            Grid.Row="2"
            Grid.Column="2"
            Margin="0,4,0,0"
            HorizontalAlignment="Right"
            Command="{Binding SaveCommand}"
            Content="Save Changes" />
    </Grid>
</Window>