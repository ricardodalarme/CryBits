<Window
    x:Class="CryBits.Editors.Forms.Npcs.EditorNpcsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CryBits.Editors.Forms.Npcs"
    Title="NPC Editor"
    Width="860"
    Height="760"
    x:DataType="vm:NpcEditorViewModel"
    CanResize="False"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ═══════════════════════════════════════════════════════  -->
        <!--  LEFT: NPC list  -->
        <!--  ═══════════════════════════════════════════════════════  -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,8,0"
            RowDefinitions="Auto,*">
            <TextBox
                x:Name="txtFilter"
                Grid.Row="0"
                Margin="0,0,0,4"
                PlaceholderText="Filter…"
                TextChanged="txtFilter_TextChanged" />
            <ListBox
                x:Name="lstNpcs"
                Grid.Row="1"
                SelectionChanged="lstNpcs_SelectionChanged"
                SelectionMode="Single" />
        </Grid>

        <!--  New / Remove (bottom-left)  -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,6,8,0"
            ColumnDefinitions="*,*">
            <Button
                Grid.Column="0"
                Margin="0,0,3,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding CreateNewCommand}"
                Content="New" />
            <Button
                Grid.Column="1"
                Margin="3,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding RemoveCommand}"
                Content="Remove" />
        </Grid>

        <!--  ═══════════════════════════════════════════════════════  -->
        <!--  RIGHT: Editor panels  -->
        <!--  ═══════════════════════════════════════════════════════  -->
        <ScrollViewer
            x:Name="pnlContent"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            IsVisible="False"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6">

                <!--  ── General ──  -->
                <Border Padding="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontWeight="Bold"
                                Text="General" />

                            <Grid ColumnDefinitions="90,*">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="Name:" />
                                <TextBox Grid.Column="1" Text="{Binding Name}" />
                            </Grid>
                            <Grid ColumnDefinitions="90,*">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="Say message:" />
                                <TextBox Grid.Column="1" Text="{Binding SayMsg}" />
                            </Grid>
                            <Grid ColumnDefinitions="90,*">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="Texture:" />
                                <NumericUpDown
                                    x:Name="numTexture"
                                    Grid.Column="1"
                                    FormatString="0"
                                    Maximum="255"
                                    Minimum="0"
                                    ValueChanged="numTexture_ValueChanged"
                                    Value="{Binding Texture}" />
                            </Grid>
                            <Grid ColumnDefinitions="90,*">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="Range (sight):" />
                                <NumericUpDown
                                    Grid.Column="1"
                                    FormatString="0"
                                    Maximum="20"
                                    Minimum="0"
                                    Value="{Binding Sight}" />
                            </Grid>
                            <Grid ColumnDefinitions="90,*">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="Spawn rate (s):" />
                                <NumericUpDown
                                    Grid.Column="1"
                                    FormatString="0"
                                    Maximum="255"
                                    Minimum="0"
                                    Value="{Binding SpawnTime}" />
                            </Grid>
                        </StackPanel>

                        <!--  Texture preview (right side of General card)  -->
                        <Border
                            Grid.Column="1"
                            Width="80"
                            Height="80"
                            Margin="8,0,0,0"
                            VerticalAlignment="Top">
                            <Image
                                x:Name="imgTexture"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Border>

                <!--  ── Attributes ──  -->
                <Border Padding="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="Bold"
                            Text="Attributes" />
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                Spacing="4">
                                <Grid ColumnDefinitions="90,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="HP:" />
                                    <NumericUpDown
                                        Grid.Column="1"
                                        FormatString="0"
                                        Maximum="32767"
                                        Minimum="0"
                                        Value="{Binding Hp}" />
                                </Grid>
                                <Grid ColumnDefinitions="90,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="MP:" />
                                    <NumericUpDown
                                        Grid.Column="1"
                                        FormatString="0"
                                        Maximum="32767"
                                        Minimum="0"
                                        Value="{Binding Mp}" />
                                </Grid>
                                <Grid ColumnDefinitions="90,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Strength:" />
                                    <NumericUpDown
                                        Grid.Column="1"
                                        FormatString="0"
                                        Maximum="32767"
                                        Minimum="0"
                                        Value="{Binding Strength}" />
                                </Grid>
                                <Grid ColumnDefinitions="90,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Resistance:" />
                                    <NumericUpDown
                                        Grid.Column="1"
                                        FormatString="0"
                                        Maximum="32767"
                                        Minimum="0"
                                        Value="{Binding Resistance}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                Spacing="4">
                                <Grid ColumnDefinitions="100,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Intelligence:" />
                                    <NumericUpDown
                                        Grid.Column="1"
                                        FormatString="0"
                                        Maximum="32767"
                                        Minimum="0"
                                        Value="{Binding Intelligence}" />
                                </Grid>
                                <Grid ColumnDefinitions="100,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Agility:" />
                                    <NumericUpDown
                                        Grid.Column="1"
                                        FormatString="0"
                                        Maximum="32767"
                                        Minimum="0"
                                        Value="{Binding Agility}" />
                                </Grid>
                                <Grid ColumnDefinitions="100,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Vitality:" />
                                    <NumericUpDown
                                        Grid.Column="1"
                                        FormatString="0"
                                        Maximum="32767"
                                        Minimum="0"
                                        Value="{Binding Vitality}" />
                                </Grid>
                                <Grid ColumnDefinitions="100,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Experience:" />
                                    <NumericUpDown
                                        Grid.Column="1"
                                        FormatString="0"
                                        Maximum="2147483647"
                                        Minimum="0"
                                        Value="{Binding Experience}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  ── Behaviour ──  -->
                <Border Padding="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="Bold"
                            Text="Behaviour" />
                        <Grid ColumnDefinitions="90,*">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="Behavior:" />
                            <ComboBox
                                x:Name="cmbBehavior"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="cmbBehavior_SelectionChanged">
                                <ComboBoxItem Content="Friendly" />
                                <ComboBoxItem Content="Attack On Sight" />
                                <ComboBoxItem Content="Attack When Attacked" />
                                <ComboBoxItem Content="Shop Keeper" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="90,*">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="Movement:" />
                            <ComboBox
                                x:Name="cmbMovement"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="cmbMovement_SelectionChanged" />
                        </Grid>
                        <Grid ColumnDefinitions="90,*">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="Flee at HP%:" />
                            <NumericUpDown
                                Grid.Column="1"
                                FormatString="0"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding FleeHealth}" />
                        </Grid>
                        <Grid
                            x:Name="pnlShop"
                            ColumnDefinitions="90,*"
                            IsVisible="False">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="Shop:" />
                            <ComboBox
                                x:Name="cmbShop"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="cmbShop_SelectionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  ── Drop ──  -->
                <Border Padding="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="Bold"
                            Text="Drop" />
                        <ListBox
                            x:Name="lstDrop"
                            Height="90"
                            SelectionMode="Single" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Click="butDrop_Add_Click" Content="Add" />
                            <Button Click="butDrop_Delete_Click" Content="Delete" />
                        </StackPanel>

                        <!--  Add-drop inline form  -->
                        <Border
                            x:Name="pnlDrop_Add"
                            Padding="8"
                            IsVisible="False">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontWeight="Bold"
                                    Text="Add drop" />
                                <Grid ColumnDefinitions="70,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Item:" />
                                    <ComboBox
                                        x:Name="cmbDrop_Item"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid ColumnDefinitions="70,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Amount:" />
                                    <NumericUpDown
                                        x:Name="numDrop_Amount"
                                        Grid.Column="1"
                                        FormatString="0"
                                        Maximum="32767"
                                        Minimum="1"
                                        Value="1" />
                                </Grid>
                                <Grid ColumnDefinitions="70,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Chance%:" />
                                    <NumericUpDown
                                        x:Name="numDrop_Chance"
                                        Grid.Column="1"
                                        FormatString="0"
                                        Maximum="100"
                                        Minimum="1"
                                        Value="100" />
                                </Grid>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button Click="butDrop_Cancel_Click" Content="Cancel" />
                                    <Button Click="butDrop_Ok_Click" Content="OK" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ── Allies ──  -->
                <Border Padding="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="Bold"
                            Text="Allies" />
                        <CheckBox
                            x:Name="chkAttackNpc"
                            Content="Attack other NPCs"
                            IsCheckedChanged="chkAttackNpc_IsCheckedChanged" />
                        <ListBox
                            x:Name="lstAllies"
                            Height="80"
                            IsEnabled="False"
                            SelectionMode="Single" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Click="butAllie_Add_Click" Content="Add" />
                            <Button Click="butAllie_Delete_Click" Content="Delete" />
                        </StackPanel>

                        <!--  Add-ally inline form  -->
                        <Border
                            x:Name="pnlAllie_Add"
                            Padding="8"
                            IsVisible="False">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontWeight="Bold"
                                    Text="Add ally" />
                                <Grid ColumnDefinitions="70,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="NPC:" />
                                    <ComboBox
                                        x:Name="cmbAllie_Npc"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch" />
                                </Grid>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button Click="butAllie_Cancel_Click" Content="Cancel" />
                                    <Button Click="butAllie_Ok_Click" Content="OK" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ── Save / Cancel ──  -->
                <Grid Margin="0,4,0,0" ColumnDefinitions="*,*">
                    <Button
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding SaveCommand}"
                        Content="Save All" />
                    <Button
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CancelCommand}"
                        Content="Cancel" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>