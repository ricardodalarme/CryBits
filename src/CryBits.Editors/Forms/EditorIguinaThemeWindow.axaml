<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CryBits.Editors.Forms.EditorIguinaThemeWindow"
        Title="Iguina Theme Editor"
        Width="1200" Height="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="8" RowDefinitions="Auto,*,Auto" ColumnDefinitions="200,8,*">

        <!-- Left: file list -->
        <Border Grid.Row="0" Grid.RowSpan="2" BorderThickness="1"
                BorderBrush="{DynamicResource SemiBorderColor}"
                CornerRadius="4" Padding="8">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Text="Theme Files" FontWeight="Bold" Margin="0,0,0,6"/>
                <ListBox x:Name="lstFiles" Grid.Row="2"
                         SelectionChanged="lstFiles_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- Right: JSON editor + preview -->
        <Grid Grid.Column="2" RowDefinitions="*,8,Auto,8,200" Grid.Row="0" Grid.RowSpan="2">

            <!-- JSON editor -->
            <Border BorderThickness="1" BorderBrush="{DynamicResource SemiBorderColor}"
                    CornerRadius="4" Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock x:Name="lblFileName" Text="Select a file" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtEditor" Grid.Row="1"
                             AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas, Courier New, monospace"
                             FontSize="12"
                             TextChanged="txtEditor_TextChanged"/>
                </Grid>
            </Border>

            <!-- Preview -->
            <Border Grid.Row="4" BorderThickness="1" BorderBrush="{DynamicResource SemiBorderColor}"
                    CornerRadius="4" Padding="8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                    <TextBlock Text="Preview" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Border Grid.Column="0" Grid.Row="1" Background="Black" CornerRadius="4">
                        <Image x:Name="imgPreview" Stretch="None"
                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Border>
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="8,0,0,0" Spacing="4">
                        <Button Content="Refresh Preview" Click="butRefreshPreview_Click"/>
                        <Button Content="Revert File" Click="butRevertFile_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom: Save -->
        <Button x:Name="butSave" Grid.Row="2" Grid.Column="2" Content="Save Changes"
                HorizontalAlignment="Right" Margin="0,4,0,0"
                Click="butSave_Click"/>
    </Grid>
</Window>
