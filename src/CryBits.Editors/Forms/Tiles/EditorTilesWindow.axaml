<Window
    x:Class="CryBits.Editors.Forms.Tiles.EditorTilesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CryBits.Editors.Forms.Tiles"
    Title="Tile Editor"
    Width="560"
    Height="620"
    x:DataType="vm:TileEditorViewModel"
    CanResize="False"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="8" RowDefinitions="Auto,*,Auto,Auto">

        <!--  ── Row 0: Tile selector ──  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,6"
            Padding="8">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="lblTile"
                    FontWeight="Bold"
                    Text="{Binding TileLabel}" />
                <ScrollBar
                    LargeChange="1"
                    Maximum="{Binding MaxTileIndex}"
                    Minimum="1"
                    Orientation="Horizontal"
                    SmallChange="1"
                    Value="{Binding TileIndex}" />
            </StackPanel>
        </Border>

        <!--  ── Row 1: Canvas + Y-scroll + right-panel ──  -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,148">

            <!--  Canvas area: tile image + X-scroll stacked  -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <!--  Tile canvas (click to paint)  -->
                <Border Grid.Row="0">
                    <Image
                        x:Name="imgCanvas"
                        Width="298"
                        Height="443"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        PointerPressed="imgCanvas_PointerPressed"
                        Stretch="None" />
                </Border>
                <!--  X scroll  -->
                <ScrollBar
                    x:Name="scrlTileX"
                    Grid.Row="1"
                    Margin="0,2,0,0"
                    LargeChange="1"
                    Maximum="0"
                    Minimum="0"
                    Orientation="Horizontal"
                    SmallChange="1"
                    Value="0" />
            </Grid>

            <!--  Y scroll  -->
            <ScrollBar
                x:Name="scrlTileY"
                Grid.Column="1"
                Margin="2,0,2,0"
                LargeChange="1"
                Maximum="0"
                Minimum="0"
                Orientation="Vertical"
                SmallChange="1"
                Value="0" />

            <!--  Right panel: Set mode + Attributes  -->
            <StackPanel Grid.Column="2" Spacing="6">

                <!--  Set mode  -->
                <Border Padding="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="0,0,0,2"
                            FontWeight="Bold"
                            Text="Set" />
                        <RadioButton
                            Content="Attributes"
                            GroupName="SetMode"
                            IsChecked="{Binding IsAttributeMode}" />
                        <RadioButton
                            Content="Dir. Block"
                            GroupName="SetMode"
                            IsChecked="{Binding !IsAttributeMode}" />
                    </StackPanel>
                </Border>

                <!--  Attributes (visible when Attributes mode is active)  -->
                <Border Padding="8" IsVisible="{Binding ShowAttributes}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="0,0,0,2"
                            FontWeight="Bold"
                            Text="Attributes" />
                        <RadioButton
                            Content="Block"
                            GroupName="AttrMode"
                            IsChecked="True" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!--  ── Row 2: spacer ──  -->
        <Border Grid.Row="2" Height="6" />

        <!--  ── Row 3: Save / Clear / Cancel ──  -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*,*">
            <Button
                Grid.Column="0"
                Margin="0,0,4,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding SaveCommand}"
                Content="Save" />
            <Button
                Grid.Column="1"
                Margin="4,0,4,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding ClearCommand}"
                Content="Clear" />
            <Button
                Grid.Column="2"
                Margin="4,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding CancelCommand}"
                Content="Cancel" />
        </Grid>

    </Grid>
</Window>
